<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Train Side-View Report - {{ train_number }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 24px; }
    h1, h2 { margin: 8px 0; }
    .summary { margin-bottom: 16px; padding: 12px; border: 1px solid #ddd; }
    .coach { margin: 18px 0; padding: 12px; border: 1px solid #ccc; border-radius: 8px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
    figure { margin: 0; }
    figcaption { font-size: 12px; color: #444; margin-top: 4px; }
    .badge { display: inline-block; padding: 4px 8px; border-radius: 6px; background: #efefef; font-size: 12px; }
  </style>
</head>
<body>
  <h1>Train Side-View Report</h1>
  <div class="summary">
    <div><strong>Train number:</strong> {{ train_number }}</div>
    <div><strong>Coach count:</strong> {{ coach_count }}</div>
    <div><strong>Input video:</strong> {{ input_video }}</div>
    <div><strong>Generated:</strong> {{ generated_at }}</div>
  </div>

  {% for coach in coaches %}
  <div class="coach">
    <h2>Coach {{ coach.index }} <span class="badge">{{ coach.video_name }}</span></h2>
    <div>Frames: {{ coach.frames|length }}</div>
    <div class="grid">
      {% for fr in coach.frames %}
      <figure>
        <img src="{{ fr.anno_path }}" alt="{{ fr.name }}" width="300">
        <figcaption>
          {{ fr.name }}
          {% if fr.detections %}
            — {{ fr.detections|join(', ') }}
          {% else %}
            — no door detected
          {% endif %}
        </figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</body>
</html>
